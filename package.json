{
  "name": "flag-ceremony",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server.ts",
    "preview": "npm run build && npm start",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/local.browser.cjs"
  },
  "dependencies": {
    "countries-list": "3.4.1",
    "express": "5.2.1",
    "flag-icons": "7.5.0",
    "three": "0.180.0",
    "tsx": "4.23.12",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/three": "0.179.0",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.4",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
